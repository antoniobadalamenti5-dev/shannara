{
  "permission_settings": {
    "allow_external_dir": true,
    "allow_bash": true,
    "allow_web": true,
    "allow_mcp_servers": true,
    "allow_editor": true
  },
  "automation": {
    "auto_accept_permissions": false,
    "require_approval_for": [
      "bash",
      "write",
      "edit",
      "delete"
    ]
  },
  "behavior": {
    "max_concurrent_agents": 2,
    "save_history": true,
    "backup_before_write": true
  },
  "profiles": {
    "default_model": "claude-sonnet-5-5",
    "fallback_models": [
      "claude-opus-5-5",
      "claude-haiku-5-5"
    ]
  },
  "enabledPlugins": {
    "pixelfx@pixelfx": true
  }
}
